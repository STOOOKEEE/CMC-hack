ity as a Central Securities Depositary.\n\nAuthorized Participants create tokens by delivering the corresponding underlying shares or subscription value. Eligible holders who satisfy applicable vesting, identity-verification, sanctions, and compliance requirements may redeem tokens for the underlying shares or through another supported settlement method.","slug":"valvoline-inc-tokenized-stock-coinbase","logo":"https://s2.coinmarketcap.com/static/img/coins/64x64/42496.png","subreddit":"","notice":"","tags":["defi","tokenized-stock","base-ecosystem","tokenized-assets","coinbase-ecosystem"],"tag-names":["DeFi","Tokenized Stock","Base Ecosystem","Tokenized Assets","Coinbase Ecosystem"],"tag-groups":["CATEGORY","CATEGORY","PLATFORM","CATEGORY","CATEGORY"],"urls":{"website":[],"twitter":[],"message_board":[],"chat":[],"facebook":[],"explorer":["https://basescan.org/token/0xb200000000000000000000FEC679b39992F67627"],"reddit":[],"technical_doc":[],"source_code":[],"announcement":[]},"platform":{"id":"27716","name":"Base","symbol":"-","slug":"base","token_address":"0xb200000000000000000000FEC679b39992F67627"},"date_added":"2026-10-08T04:00:01.000Z","twitter_username":"","is_hidden":0,"contract_address":[{"contract_address":"0xb200000000000000000000FEC679b39992F67627","platform":{"name":"Base","coin":{"id":"27716","name":"Base","symbol":"-","slug":"base"}}}],"infinite_supply":false}},"tokenQuotes":{"40784":{"tags":[{"slug":"defi","name":"DeFi","category":"CATEGORY"},{"slug":"tokenized-stock","name":"Tokenized Stock","category":"CATEGORY"},{"slug":"synthetics","name":"Synthetics","category":"INDUSTRY"},{"slug":"tokenized-assets","name":"Tokenized Assets","category":"CATEGORY"},{"slug":"tradfi-assets-derivatives","name":"TradFi Assets (Derivatives)","category":"CATEGORY"}],"id":40784,"name":"Valvoline Inc (Derivatives)","symbol":"VVV","slug":"valvoline-inc-derivatives","is_active":1,"infinite_supply":false,"is_fiat":0,"circulating_supply":0,"total_supply":0,"max_supply":null,"d