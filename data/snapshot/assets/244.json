 Onchain SPV Ltd. The underlying shares are held in segregated custody, while Onchain Marketplace Ltd operates the tokenization infrastructure and maintains the definitive legal ownership register in its capacity as a Central Securities Depositary.\n\nAuthorized Participants create tokens by delivering the corresponding underlying shares or subscription value. Eligible holders who satisfy applicable vesting, identity-verification, sanctions, and compliance requirements may redeem tokens for the underlying shares or through another supported settlement method.","slug":"soundhound-ai-inc-tokenized-stock-coinbase","logo":"https://s2.coinmarketcap.com/static/img/coins/64x64/42476.png","subreddit":"","notice":"","tags":["defi","tokenized-stock","base-ecosystem","tokenized-assets","coinbase-ecosystem"],"tag-names":["DeFi","Tokenized Stock","Base Ecosystem","Tokenized Assets","Coinbase Ecosystem"],"tag-groups":["CATEGORY","CATEGORY","PLATFORM","CATEGORY","CATEGORY"],"urls":{"website":[],"twitter":[],"message_board":[],"chat":[],"facebook":[],"explorer":["https://basescan.org/token/0xb2000000000000000000002137743d4a01fe4e88"],"reddit":[],"technical_doc":[],"source_code":[],"announcement":[]},"platform":{"id":"27716","name":"Base","symbol":"-","slug":"base","token_address":"0xb2000000000000000000002137743d4a01fe4e88"},"date_added":"2026-10-08T03:59:59.000Z","twitter_username":"","is_hidden":0,"contract_address":[{"contract_address":"0xb2000000000000000000002137743d4a01fe4e88","platform":{"name":"Base","coin":{"id":"27716","name":"Base","symbol":"-","slug":"base"}}}],"infinite_supply":false}},"tokenQuotes":{"39248":{"tags":[{"slug":"ethereum-ecosystem","name":"Ethereum Ecosystem","category":"PLATFORM"},{"slug":"solana-ecosystem","name":"Solana Ecosystem","category":"PLATFORM"},{"slug":"bnb-chain-ecosystem","name":"BNB Chain Ecosystem","category":"PLATFORM"},{"slug":"tokenized-assets","name":"Tokenized Assets","category":"CATEGORY"},{"slug":"ondo-stocks-ecosystem","name":"Ondo