fab7a2"],"reddit":[],"technical_doc":[],"source_code":[],"announcement":[]},"platform":{"id":"1839","name":"BNB","symbol":"BNB","slug":"bnb","token_address":"0xf4ddb292fe88e476eddd9869d386705e6bfab7a2"},"date_added":"2026-09-29T10:53:42.000Z","twitter_username":"","is_hidden":0,"contract_address":[{"contract_address":"0xf4ddb292fe88e476eddd9869d386705e6bfab7a2","platform":{"name":"BNB Smart Chain (BEP20)","coin":{"id":"1839","name":"BNB","symbol":"BNB","slug":"bnb"}}}],"infinite_supply":false},"42756":{"id":42756,"name":"Zoom Communications, Inc. Tokenized Stock (Coinbase)","symbol":"ZMc","category":"token","description":"About Zoom Communications, Inc. (Coinbase Tokenized Stock) (ZMc)\n\nZoom Communications, Inc. (Coinbase Tokenized Stock) is an onchain certificate that provides economic exposure to shares of Zoom Communications, Inc. through a tokenized security issued by Coinbase Onchain SPV Ltd in the Abu Dhabi Global Market (ADGM).\n\nEach token initially represents a 1:1 beneficial interest in shares held in a segregated custody account with a regulated broker-dealer and custodian. The applicable share-to-token ratio may change over time to reflect reinvested distributions, fees, taxes, corporate actions, and other adjustments.\n\nThe token can be held and transferred through supported blockchain networks and used in decentralized finance markets. Dividends and other distributions received on the underlying shares are generally reinvested, after applicable taxes, fees, and expenses, with the resulting economic benefit reflected through an adjustment to the share-to-token ratio.\n\nWhat Is Zoom Communications, Inc. (Coinbase Tokenized Stock)?\n\nZoom Communications, Inc. (Coinbase Tokenized Stock) is part of Coinbase’s onchain capital-markets infrastructure, designed to represent traditional financial instruments as regulated digital securities.\n\nThe token is a certificate over shares rather than a direct investment in Zoom Communications, Inc. Each token represents a proportional beneficial interest in the pool of underlying shares and related property held on trust by Coinbase Onchain SPV Ltd. The underlying shares are held in segregated custody, while Onchain Marketplace Ltd operates the tokenization infrastructure and maintains the definitive legal ownership register in its capacity as a Central Securities Depositary.\n\nAuthorized Participants create tokens by delivering the corresponding underlying shares or subscription value. Eligible holders who satisfy applicable vesting, identity-verification, sanctions, and compliance requirements may redeem tokens for the underlying shares or through another supported settlement method.","slug":"zoom-communications-inc-tokenized-stock-coinbase","logo":"https://s2.coinmarketcap.com/static/img/coins/64x64/42756.png","subreddit":"","notice":"","tags":["defi","tokenized-stock","base-ecosystem","tokenized-assets","coinbase-ecosystem"],"tag-names":["DeFi","Tokenized Stock","Base Ecosystem","Tokenized Assets","Coinbase Ecosystem"],"tag-groups":["CATEGORY","CATEGORY","PLATFORM","CATEGORY","CATEGORY"],"urls":{"website":[],"twitter":[],"message_board":[],"chat":[],"facebook":[],"explorer":["https://basescan.org/token/0xB2000000000000000000000E63b7B0b6BC5B9213"],"reddit":[],"technical_doc":[],"source_code":[],"announcement":[]},"platform":{"id":"27716","name":"Base","symbol":"-","slug":"base","token_address":"0xB2000000000000000000000E63b7B0b6BC5B9213"},"date_added":"2026-11-02T08:29:27.000Z","twitter_username":"","is_hidden":0,"contract_address":[{"contract_address":"0xB2000000000000000000000E63b7B0b6BC5B9213","platform":{"name":"Base","coin":{"id":"27716","name":"Base","symbol":"-","slug":"base"}}}],"infinite_supply":false}},"tokenQuotes":{"39954":{"tags":[{"slug":"defi","name":"DeFi","category":"CATEGORY"},{"slug":"tokenized-stock","name":"Tokenized Stock","category":"CATEGORY"},{"slug":"synthetics","name":"Synthetics","category":"INDUSTRY"},{"slug":"binance-ecosystem","name":"Bina