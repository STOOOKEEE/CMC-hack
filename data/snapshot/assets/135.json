orer":[],"reddit":[],"technical_doc":[],"source_code":[],"announcement":[]},"platform":null,"date_added":"2026-06-23T11:23:49.000Z","twitter_username":"","is_hidden":0,"infinite_supply":false},"41585":{"id":41585,"name":"Wrapped Snowflake Tokenized Stock (xStock)","symbol":"wSNOWx","category":"token","description":"Wrapped Snowflake xStock (wSNOWx) is the non-rebasing ERC-20/ERC-4626 wrapped version of Snowflake xStock (SNOWx) on X Layer. Vault shares represent a proportional claim on the underlying xStock deposited in the wrapper (0x18af2B532AC2D9fD18E9099A57fa3585f4bfA931), and wrap/unwrap conversion uses the live xStocks multiplier.","slug":"wrapped-snowflake-tokenized-stock-xstock","logo":"https://s2.coinmarketcap.com/static/img/coins/64x64/41585.png","subreddit":"","notice":"","tags":["defi","tokenized-stock","x-layer-ecosystem","tokenized-assets","xstocks-ecosystem"],"tag-names":["DeFi","Tokenized Stock","X Layer Ecosystem","Tokenized Assets","xStocks Ecosystem"],"tag-groups":["CATEGORY","CATEGORY","PLATFORM","CATEGORY","CATEGORY"],"urls":{"website":["https://xstocks.fi"],"twitter":["https://twitter.com/xstocksfi"],"message_board":[],"chat":["https://defi.xstocks.fi/wrap"," https://docs.xstocks.fi/developers/wrapped-xstocks"," https://t.me/xstocksfi"," https://www.linkedin.com/company/backed-finance/"],"facebook":[],"explorer":["https://www.oklink.com/x-layer/address/0x4008afF72114BCb8529fFD8E2D8d25c55C619D6C"],"reddit":[],"technical_doc":[],"source_code":[],"announcement":[]},"platform":{"id":"3897","name":"OKB","symbol":"OKB","slug":"okb","token_address":"0x4008afF72114BCb8529fFD8E2D8d25c55C619D6C"},"date_added":"2026-08-11T16:25:23.000Z","twitter_username":"xstocksfi","is_hidden":0,"contract_address":[{"contract_address":"0x4008afF72114BCb8529fFD8E2D8d25c55C619D6C","platform":{"name":"X Layer","coin":{"id":"3897","name":"OKB","symbol":"OKB","slug":"okb"}}}],"infinite_supply":false},"42742":{"id":42742,"name":"Snowflake Inc. Tokenized Stock (Coinbase)","symbol":"SNOWc","category":"token","description":"About Snowflake Inc. (Coinbase Tokenized Stock) (SNOWc)\n\nSnowflake Inc. (Coinbase Tokenized Stock) is an onchain certificate that provides economic exposure to shares of Snowflake Inc. through a tokenized security issued by Coinbase Onchain SPV Ltd in the Abu Dhabi Global Market (ADGM).\n\nEach token initially represents a 1:1 beneficial interest in shares held in a segregated custody account with a regulated broker-dealer and custodian. The applicable share-to-token ratio may change over time to reflect reinvested distributions, fees, taxes, corporate actions, and other adjustments.\n\nThe token can be held and transferred through supported blockchain networks and used in decentralized finance markets. Dividends and other distributions received on the underlying shares are generally reinvested, after applicable taxes, fees, and expenses, with the resulting economic benefit reflected through an adjustment to the share-to-token ratio.\n\nWhat Is Snowflake Inc. (Coinbase Tokenized Stock)?\n\nSnowflake Inc. (Coinbase Tokenized Stock) is part of Coinbase’s onchain capital-markets infrastructure, designed to represent traditional financial instruments as regulated digital securities.\n\nThe token is a certificate over shares rather than a direct investment in Snowflake Inc. Each token represents a proportional beneficial interest in the pool of underlying shares and related property held on trust by Coinbase Onchain SPV Ltd. The underlying shares are held in segregated custody, while Onchain Marketplace Ltd operates the tokenization infrastructure and maintains the definitive legal ownership register in its capacity as a Central Securities Depositary.\n\nAuthorized Participants create tokens by delivering the corresponding underlying shares or subscription value. Eligible holders who satisfy applicable vesting, identity-verification, sanctions, and compliance requirements may redeem tokens for the underlying shares or through another supported settlement method.","slug":"snowflake-inc-tokenized-stock-coinbase","logo":"https://s2.coinmarketcap.com/static/img/coins/64x64/42742.png","subreddit":"","notice":"","tags":["defi","tokenized-stock","base-ecosystem","tokenized-assets","coinbase-ecosystem"],"tag-names":["DeFi","Tokenized Stock","Base Ecosystem","Tokenized Assets","Coinbase Ecosystem"],"tag-groups":["CATEGORY","CATEGORY","PLATFORM","CATEGORY","CATEGORY"],"urls":{"website":[],"twitter":[],"message_board":[],"chat":[],"facebook":[],"explorer":["https://basescan.org/token/0xB2000000000000000000004AcDC9A922FCfBCc7f"],"reddit":[],"technical_doc":[],"source_code":[],"announcement":[]},"platform":{"id":"27716","name":"Base","symbol":"-","slug":"base","token_address":"0xB2000000000000000000004AcDC9A922FCfBCc7f"},"date_added":"2026-11-02T08:29:22.000Z","twitter_username":"","is_hidden":0,"contract_address":[{"contract_address":"0xB2000000000000000000004AcDC9A922FCfBCc7f","platform":{"name":"Base","coin":{"id":"27716","name":"Base","symbol":"-","slug":"base"}}}],"infinite_supply":false}},"tokenQuotes":{"38063":{"tags":[{"slug":"defi","name":"DeFi","category":"CATEGORY"},{"slug":"ethereum-ecosystem","name":"Ethereum Ecosystem","category":"PLATFORM"},{"slug":"tokenized-stock","name":"Tokenized Stock","category":"CATEGORY"},{"slug":"solana-ecosystem","name":"Solana Ecosystem","category":"PLATFORM"},{"slug":"bnb-chain-ecosystem","name":"BNB Chain Ecosystem","category":"PLATFORM"},{"slug":"binance-alpha","name":"Binance Alpha","category":"CATEGORY"},{"slug":"binance-ecosystem","name":"Binance Ecosystem","category":"CATEGORY"},{"slug":"tokenized-assets","name":"Tokenized Assets","category":"CATEGORY"},{"slug":"ondo-stocks-ecosystem","name":"Ondo Stocks Ecosystem","category":"CATEGORY"}],"id":38063,"name":"Snowflake Tokenized Stock (Ondo)","symbol":"SNOWon","slug":"snowflake-tokenized-stock-ondo","is_active":1,"infinite_supply":false,"is_fiat":0,"circulating_supply":4690.84619165,"total_supply":46