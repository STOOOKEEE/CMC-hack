f3f614fc6441bc","platform":{"name":"X Layer","coin":{"id":"3897","name":"OKB","symbol":"OKB","slug":"okb"}}}],"infinite_supply":true},"42517":{"id":42517,"name":"Rivian Automotive, Inc. Tokenized Stock (Coinbase)","symbol":"RIVNc","category":"token","description":"About Rivian Automotive, Inc. (Coinbase Tokenized Stock) (RIVNc)\n\nRivian Automotive, Inc. (Coinbase Tokenized Stock) is an onchain certificate that provides economic exposure to shares of Rivian Automotive, Inc. through a tokenized security issued by Coinbase Onchain SPV Ltd in the Abu Dhabi Global Market (ADGM).\n\nEach token initially represents a 1:1 beneficial interest in shares held in a segregated custody account with a regulated broker-dealer and custodian. The applicable share-to-token ratio may change over time to reflect reinvested distributions, fees, taxes, corporate actions, and other adjustments.\n\nThe token can be held and transferred through supported blockchain networks and used in decentralized finance markets. Dividends and other distributions received on the underlying shares are generally reinvested, after applicable taxes, fees, and expenses, with the resulting economic benefit reflected through an adjustment to the share-to-token ratio.\n\nWhat Is Rivian Automotive, Inc. (Coinbase Tokenized Stock)?\n\nRivian Automotive, Inc. (Coinbase Tokenized Stock) is part of Coinbase’s onchain capital-markets infrastructure, designed to represent traditional financial instruments as regulated digital securities.\n\nThe token is a certificate over shares rather than a direct investment in Rivian Automotive, Inc. Each token represents a proportional beneficial interest in the pool of underlying shares and related property held on trust by Coinbase Onchain SPV Ltd. The underlying shares are held in segregated custody, while Onchain Marketplace Ltd operates the tokenization infrastructure and maintains the definitive legal ownership register in its capacity as a Central Securities Depositary.\n\nAuthorized Participants create tokens by delivering the corresponding underlying shares or subscription value. Eligible holders who satisfy applicable vesting, identity-verification, sanctions, and compliance requirements may redeem tokens for the underlying shares or through another supported settlement method.","slug":"rivian-automotive-inc-tokenized-stock-coinbase","logo":"https://s2.coinmarketcap.com/static/img/coins/64x64/42517.png","subreddit":"","notice":"","tags":["defi","tokenized-stock","base-ecosystem","tokenized-assets","coinbase-ecosystem"],"tag-names":["DeFi","Tokenized Stock","Base Ecosystem","Tokenized Assets","Coinbase Ecosystem"],"tag-groups":["CATEGORY","CATEGORY","PLATFORM","CATEGORY","CATEGORY"],"urls":{"website":[],"twitter":[],"message_board":[],"chat":[],"facebook":[],"explorer":["https://basescan.org/token/0xb2000000000000000000003e4249c65bd6c037d9"],"reddit":[],"technical_doc":[],"source_code":[],"announcement":[]},"platform":{"id":"27716","name":"Base","symbol":"-","slug":"base","token_address":"0xb2000000000000000000003e4249c65bd6c037d9"},"date_added":"2026-10-08T03:59:32.000Z","twitter_username":"","is_hidden":0,"contract_address":[{"contract_address":"0xb2000000000000000000003e4249c65bd6c037d9","platform":{"name":"Base","coin":{"id":"27716","name":"Base","symbol":"-","slug":"base"}}}],"infinite_supply":false}},"tokenQuotes":{"39256":{"tags":[{"slug":"ethereum-ecosystem","name":"Ethereum Ecosystem","category":"PLATFORM"},{"slug":"solana-ecosystem","name":"Solana Ecosystem","category":"PLATFORM"},{"slug":"bnb-chain-ecosystem","name":"BNB Chain Ecosystem","category":"PLATFORM"},{"slug":"binance-alpha","name":"Binance Alpha","category":"CATEGORY"},{"slug":"binance-ecosystem","name":"Binance Ecosystem","category":"CATEGORY"},{"slug":"tokenized-assets","name":"Tokenized Assets","category":"CATEGORY"},{"slug":"hyperevm-ecosystem","name":"HyperEVM Ecosystem","category":"PLATFORM"},{"slug":"ondo-stocks-ecosystem","name":"Ondo Stocks Ecosystem","c