s.fi/developers/wrapped-xstocks"," https://t.me/xstocksfi"," https://www.linkedin.com/company/backed-finance/"],"facebook":[],"explorer":["https://www.oklink.com/x-layer/address/0x11704Bb8fDf32Af2f70fB3F085d437b9b3E66a94"],"reddit":[],"technical_doc":[],"source_code":[],"announcement":[]},"platform":{"id":"3897","name":"OKB","symbol":"OKB","slug":"okb","token_address":"0x11704Bb8fDf32Af2f70fB3F085d437b9b3E66a94"},"date_added":"2026-08-11T16:27:02.000Z","twitter_username":"xstocksfi","is_hidden":0,"contract_address":[{"contract_address":"0x11704Bb8fDf32Af2f70fB3F085d437b9b3E66a94","platform":{"name":"X Layer","coin":{"id":"3897","name":"OKB","symbol":"OKB","slug":"okb"}}}],"infinite_supply":false},"42765":{"id":42765,"name":"Visa Inc. Tokenized Stock (Coinbase)","symbol":"Vc","category":"token","description":"About Visa Inc. (Coinbase Tokenized Stock) (Vc)\n\nVisa Inc. (Coinbase Tokenized Stock) is an onchain certificate that provides economic exposure to shares of Visa Inc. through a tokenized security issued by Coinbase Onchain SPV Ltd in the Abu Dhabi Global Market (ADGM).\n\nEach token initially represents a 1:1 beneficial interest in shares held in a segregated custody account with a regulated broker-dealer and custodian. The applicable share-to-token ratio may change over time to reflect reinvested distributions, fees, taxes, corporate actions, and other adjustments.\n\nThe token can be held and transferred through supported blockchain networks and used in decentralized finance markets. Dividends and other distributions received on the underlying shares are generally reinvested, after applicable taxes, fees, and expenses, with the resulting economic benefit reflected through an adjustment to the share-to-token ratio.\n\nWhat Is Visa Inc. (Coinbase Tokenized Stock)?\n\nVisa Inc. (Coinbase Tokenized Stock) is part of Coinbase’s onchain capital-markets infrastructure, designed to represent traditional financial instruments as regulated digital securities.\n\nThe token is a certificate over shares rather than a direct investment in Visa Inc. Each token represents a proportional beneficial interest in the pool of underlying shares and related property held on trust by Coinbase Onchain SPV Ltd. The underlying shares are held in segregated custody, while Onchain Marketplace Ltd operates the tokenization infrastructure and maintains the definitive legal ownership register in its capacity as a Central Securities Depositary.\n\nAuthorized Participants create tokens by delivering the corresponding underlying shares or subscription value. Eligible holders who satisfy applicable vesting, identity-verification, sanctions, and compliance requirements may redeem tokens for the underlying shares or through another supported settlement method.","slug":"visa-inc-tokenized-stock-coinbase","logo":"https://s2.coinmarketcap.com/static/img/coins/64x64/42765.png","subreddit":"","notice":"","tags":["defi","tokenized-stock","base-ecosystem","tokenized-assets","coinbase-ecosystem"],"tag-names":["DeFi","Tokenized Stock","Base Ecosystem","Tokenized Assets","Coinbase Ecosystem"],"tag-groups":["CATEGORY","CATEGORY","PLATFORM","CATEGORY","CATEGORY"],"urls":{"website":[],"twitter":[],"message_board":[],"chat":[],"facebook":[],"explorer":["https://basescan.org/token/0xB20000000000000000000054b11Fd279a4f7D4EF"],"reddit":[],"technical_doc":[],"source_code":[],"announcement":[]},"platform":{"id":"27716","name":"Base","symbol":"-","slug":"base","token_address":"0xB20000000000000000000054b11Fd279a4f7D4EF"},"date_added":"2026-11-02T08:29:31.000Z","twitter_username":"","is_hidden":0,"contract_address":[{"contract_address":"0xB20000000000000000000054b11Fd279a4f7D4EF","platform":{"name":"Base","coin":{"id":"27716","name":"Base","symbol":"-","slug":"base"}}}],"infinite_supply":false}},"tokenQuotes":{"37046":{"tags":[{"slug":"defi","name":"DeFi","category":"CATEGORY"},{"slug":"ethereum-ecosystem","name":"Ethereum Ecosystem","category":"PLATFORM"},{"slug":"tokenized-s