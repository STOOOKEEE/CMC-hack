nterest in the pool of underlying shares and related property held on trust by Coinbase Onchain SPV Ltd. The underlying shares are held in segregated custody, while Onchain Marketplace Ltd operates the tokenization infrastructure and maintains the definitive legal ownership register in its capacity as a Central Securities Depositary.\n\nAuthorized Participants create tokens by delivering the corresponding underlying shares or subscription value. Eligible holders who satisfy applicable vesting, identity-verification, sanctions, and compliance requirements may redeem tokens for the underlying shares or through another supported settlement method.","slug":"hut-8-corp-tokenized-stock-coinbase","logo":"https://s2.coinmarketcap.com/static/img/coins/64x64/42495.png","subreddit":"","notice":"","tags":["defi","tokenized-stock","base-ecosystem","tokenized-assets","coinbase-ecosystem"],"tag-names":["DeFi","Tokenized Stock","Base Ecosystem","Tokenized Assets","Coinbase Ecosystem"],"tag-groups":["CATEGORY","CATEGORY","PLATFORM","CATEGORY","CATEGORY"],"urls":{"website":[],"twitter":[],"message_board":[],"chat":[],"facebook":[],"explorer":["https://basescan.org/token/0xb2000000000000000000006Ee1C139a723872e09"],"reddit":[],"technical_doc":[],"source_code":[],"announcement":[]},"platform":{"id":"27716","name":"Base","symbol":"-","slug":"base","token_address":"0xb2000000000000000000006Ee1C139a723872e09"},"date_added":"2026-10-08T03:59:49.000Z","twitter_username":"","is_hidden":0,"contract_address":[{"contract_address":"0xb2000000000000000000006Ee1C139a723872e09","platform":{"name":"Base","coin":{"id":"27716","name":"Base","symbol":"-","slug":"base"}}}],"infinite_supply":false}},"tokenQuotes":{"41349":{"tags":[{"slug":"defi","name":"DeFi","category":"CATEGORY"},{"slug":"tokenized-stock","name":"Tokenized Stock","category":"CATEGORY"},{"slug":"x-layer-ecosystem","name":"X Layer Ecosystem","category":"PLATFORM"},{"slug":"tokenized-assets","name":"Tokenized Assets","category":"CATEGORY"